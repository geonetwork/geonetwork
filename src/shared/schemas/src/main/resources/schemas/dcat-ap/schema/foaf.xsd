<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:dct="http://purl.org/dc/terms/"
           xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
           xmlns:foaf="http://xmlns.com/foaf/0.1/"
           xmlns:locn="http://www.w3.org/ns/locn#"
           xmlns:org="http://www.w3.org/ns/org#"
           xmlns:cv="http://data.europa.eu/m8g/"
           targetNamespace="http://xmlns.com/foaf/0.1/"
           elementFormDefault="qualified" attributeFormDefault="qualified">
  <xs:annotation>
    <xs:documentation xml:lang="en">
      FOAF XML Schema  (relevant parts for DCAT-AP)
      http://xmlns.com/foaf/0.1/
    </xs:documentation>
  </xs:annotation>

  <xs:import namespace="http://purl.org/dc/terms/" schemaLocation="dcterms.xsd"/>
  <xs:import namespace="http://www.w3.org/1999/02/22-rdf-syntax-ns#" schemaLocation="rdf.xsd"/>
  <xs:import namespace="http://www.w3.org/ns/locn#" schemaLocation="locn.xsd"/>
  <xs:import namespace="http://www.w3.org/ns/org#" schemaLocation="org.xsd"/>
  <xs:import namespace="http://data.europa.eu/m8g/" schemaLocation="cv.xsd"/>

  <!-- foaf:Document-->
  <xs:complexType name="Document">
    <xs:sequence>
      <xs:element name="Document">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="name" type="rdf:PlainLiteral" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
          <xs:attribute ref="rdf:about"/>
          <xs:attribute ref="rdf:nodeID"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>


  <!-- foaf:Agent-->
  <xs:complexType name="Agent">
    <xs:sequence>
      <xs:element name="Agent">
        <xs:complexType>
          <xs:sequence>
            <!-- mandatory properties for foaf:Agent-->
            <xs:element ref="foaf:name" minOccurs="1" maxOccurs="unbounded"/>
            <!-- recommended properties for foaf:Agent-->
            <xs:element ref="dct:type" minOccurs="0" maxOccurs="1"/>

            <!-- Mobility DCAT-AP properties -->
            <xs:element ref="foaf:workplaceHomepage" minOccurs="0" maxOccurs="1"/>
            <xs:element ref="locn:address" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element ref="org:memberOf" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element ref="foaf:mbox" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element ref="foaf:firstName" minOccurs="0" maxOccurs="1"/>
            <xs:element ref="foaf:surname" minOccurs="0" maxOccurs="1"/>
            <xs:element ref="foaf:phone" minOccurs="0" maxOccurs="unbounded"/>

            <!-- HEALTH DCAT-AP -->
            <xs:element ref="cv:contactPoint" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element ref="dct:description" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
          <xs:attribute ref="rdf:about"/>
          <xs:attribute ref="rdf:nodeID"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="primaryTopic" type="rdf:ResourceRef"/>
  <xs:element name="page" type="foaf:Document"/>
  <xs:element name="homepage" type="foaf:Document"/>
  <xs:element name="workplaceHomepage" type="rdf:ResourceRef"/>
  <xs:element name="mbox" type="rdf:ResourceRef"/>
  <xs:element name="name" type="rdf:PlainLiteral"/>
  <xs:element name="firstName" type="rdf:PlainLiteral"/>
  <xs:element name="surname" type="rdf:PlainLiteral"/>
  <xs:element name="phone" type="rdf:ResourceRef"/>
</xs:schema>
