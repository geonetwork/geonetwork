<!--
    Maps the OGC API Records "time" property to the temporal extent only.

    00029 mapped it to resourceTemporalDateRange, which also holds the creation, publication and
    revision dates of the resource. resourceTemporalExtentDateRange holds the temporal extent alone.

    Only updates the row if it still has the value set by 00029, so a mapping changed by an admin
    is kept.
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="00036-ogcapi-field-mapping-time-temporal-extent" author="geonetwork">
        <update tableName="ogcapi_field_mapping">
            <column name="elastic_property" value="resourceTemporalExtentDateRange"/>
            <where>config_id = 'property-mapping' AND ogc_property = 'time' AND elastic_property = 'resourceTemporalDateRange'</where>
        </update>
    </changeSet>

</databaseChangeLog>
