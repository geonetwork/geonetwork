<!--
    Maps the OGC API Records "time" property to resourceTemporalExtentDateRange instead of
    resourceTemporalDateRange (#247), so CQL filters on time use the temporal extent of the resource
    only, like the item output and the datetime parameter. resourceTemporalDateRange also has the
    creation, publication and revision dates of the resource.

    Only updates the row while it still has the old default, so an admin-customised mapping is
    never overwritten. config/application-ogcapi-records.yml is not changed, so a new install
    seeded from the YAML still maps time to resourceTemporalDateRange.
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="00036-ogcapi-field-mapping-time-temporal-extent" author="geonetwork">
        <update tableName="ogcapi_field_mapping">
            <column name="elastic_property" value="resourceTemporalExtentDateRange"/>
            <where>config_id = 'property-mapping' AND ogc_property = 'time' AND elastic_property = 'resourceTemporalDateRange'</where>
        </update>
    </changeSet>

</databaseChangeLog>
