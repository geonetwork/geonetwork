<!--
    Adds CQL-filter field mappings for the OGC API Records "built-in" queryables (id, created,
    updated, language, languages, organization, title, description, keywords, geometry, time -
    see queryables.json). These were previously only resolvable by name in the /queryables and
    /items facets responses, but had no entry in ogcapi_field_mapping, so CQL2 filters referencing
    them (e.g. filter=title='foo') failed.

    Each changeSet only inserts its row when the ogcapi_property_mapping config row already exists
    (i.e. this is an upgrade of a running instance whose config was already seeded before this
    fix - see OgcApiPropertyMappingService#seedFromYamlIfAbsent) AND that ogc_property isn't
    already present (so a previously admin-customized mapping is never overwritten). On a brand
    new install there is no config row yet, so every changeSet here is a no-op (MARK_RAN); the
    row gets created already-complete from config/application-ogcapi-records.yml on first boot.
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="00029-ogcapi-field-mapping-builtin-id" author="geonetwork">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">
                SELECT CASE WHEN EXISTS (SELECT 1 FROM ogcapi_property_mapping WHERE id = 'property-mapping')
                            AND NOT EXISTS (SELECT 1 FROM ogcapi_field_mapping WHERE config_id = 'property-mapping' AND ogc_property = 'id')
                       THEN 1 ELSE 0 END
            </sqlCheck>
        </preConditions>
        <insert tableName="ogcapi_field_mapping">
            <column name="config_id" value="property-mapping"/>
            <column name="sort_order" valueNumeric="100"/>
            <column name="ogc_property" value="id"/>
            <column name="elastic_property" value="uuid"/>
            <column name="is_sortable" valueBoolean="false"/>
            <column name="is_queryable" valueBoolean="false"/>
            <column name="add_property_to_output" valueBoolean="true"/>
        </insert>
    </changeSet>

