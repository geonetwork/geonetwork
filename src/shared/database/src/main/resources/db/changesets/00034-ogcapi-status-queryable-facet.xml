<!--
    Adds an OGC API Records "status" queryable/facet backed by the ISO 19115 progress codelist
    (indexed as cl_status), so records can be filtered on it (e.g. filter=status='obsolete') and
    the status is included in the item output (see geonetwork/geonetwork#226).

    Same upgrade-only pattern as 00030: rows are only inserted when the ogcapi_property_mapping
    config row already exists and the mapping isn't present yet. On a brand new install both
    changeSets are a no-op (MARK_RAN); the rows get created from
    config/application-ogcapi-records.yml on first boot.
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="00034-ogcapi-field-mapping-status" author="geonetwork">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">
                SELECT CASE WHEN EXISTS (SELECT 1 FROM ogcapi_property_mapping WHERE id = 'property-mapping')
                            AND NOT EXISTS (SELECT 1 FROM ogcapi_field_mapping WHERE config_id = 'property-mapping' AND ogc_property = 'status')
                       THEN 1 ELSE 0 END
            </sqlCheck>
        </preConditions>
        <insert tableName="ogcapi_field_mapping">
            <column name="config_id" value="property-mapping"/>
            <column name="sort_order" valueNumeric="114"/>
            <column name="ogc_property" value="status"/>
            <column name="elastic_property" value="cl_status.key"/>
            <column name="index_record_property" value='codelists.["cl_status"].[*].properties.["key"]'/>
            <column name="type_override" value="LIST_STRING"/>
            <column name="is_sortable" valueBoolean="false"/>
            <column name="is_queryable" valueBoolean="true"/>
            <column name="add_property_to_output" valueBoolean="true"/>
        </insert>
    </changeSet>

    <changeSet id="00034-ogcapi-facet-config-status" author="geonetwork">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">
                SELECT CASE WHEN EXISTS (SELECT 1 FROM ogcapi_field_mapping WHERE config_id = 'property-mapping' AND ogc_property = 'status')
                            AND NOT EXISTS (SELECT 1 FROM ogcapi_facet_config fc
                                            JOIN ogcapi_field_mapping fm ON fm.id = fc.field_mapping_id
                                            WHERE fm.config_id = 'property-mapping' AND fm.ogc_property = 'status' AND fc.facet_name = 'status')
                       THEN 1 ELSE 0 END
            </sqlCheck>
        </preConditions>
        <sql>
            INSERT INTO ogcapi_facet_config (field_mapping_id, sort_order, facet_name, facet_type)
            SELECT id, 0, 'status', 'TERM'
            FROM ogcapi_field_mapping
            WHERE config_id = 'property-mapping' AND ogc_property = 'status'
        </sql>
    </changeSet>

</databaseChangeLog>
